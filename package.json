{
  "name": "boutique-gestion",
  "productName": "Boutique Gestion",
  "version": "0.1.0",
  "description": "Gestion de boutique multi-familles : stock, inventaire, caisse, clients, fournisseurs, rapports",
  "private": true,
  "author": "Armand",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && electron-vite build -c electron.vite.demo.config.ts && playwright test",
    "test:load": "vitest run --config vitest.load.config.mts",
    "seed": "electron-vite build -c electron.vite.demo.config.ts && electron out-demo/seed-main.js",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:signed": "npm run build && electron-builder --win nsis -c.win.forceCodeSigning=true",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.23",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "bwip-js": "4.11.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.71.0",
    "node-thermal-printer": "4.6.1",
    "pdfmake": "0.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-is": "18.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": false,
    "electron-winstaller": false
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
