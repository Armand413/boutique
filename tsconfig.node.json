{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "tools/**/*",
    "electron.vite.config.ts",
    "electron.vite.demo.config.ts",
    "vitest.config.mts",
    "vitest.load.config.mts",
    "playwright.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["tests/unit/renderer/**/*", "tests/e2e/**/*"]
}
